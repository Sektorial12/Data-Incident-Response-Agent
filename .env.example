# DataHub
DATAHUB_SERVER_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_ACCESS_TOKEN=your_personal_access_token

# MCP Server
TOOLS_IS_MUTATION_ENABLED=true
TOOLS_DATAHUB_API_TOKEN=your_datahub_token

# LLM (any one — Anthropic takes priority, then OpenAI, then Google)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Agent Config
AGENT_MAX_LINEAGE_HOPS=3
AGENT_CONFIDENCE_THRESHOLD=0.5
AGENT_TIMEOUT_SECONDS=30
